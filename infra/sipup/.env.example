# Copy to .env (not committed) — docker compose and documentation only.
# Asterisk reads values from *.conf files you generate; keep secrets out of git.

# Backend mode for real-call Asterisk integration
APP_ENV=development
TELEPHONY_PROVIDER=sip_up

# Host port bindings
ASTERISK_SIP_BIND=5060
ASTERISK_SIP_TCP_BIND=5060
ASTERISK_SIP_TLS_BIND=5061
ASTERISK_HTTP_BIND=8088
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10100

# Document alongside ari.conf / pjsip.conf (used by your ARI client or runbooks)
# ASTERISK_ARI_HOST=localhost
# ASTERISK_ARI_PORT=8088
# ASTERISK_ARI_USER=ari-dev-user
# ASTERISK_ARI_PASSWORD=generate-a-long-random-value
ASTERISK_HOST=localhost
ASTERISK_PORT=8088
ASTERISK_USERNAME=
ASTERISK_PASSWORD=
ASTERISK_CONTEXT=ivr-outbound
ASTERISK_ENDPOINT=sip-up-trunk
ASTERISK_ARI_PREFIX=/asterisk/ari
ASTERISK_ARI_APP=ivr-bridge
ASTERISK_CALLER_ID=393888736444
ASTERISK_ORIGINATE_TIMEOUT_SECONDS=30
ASTERISK_ARI_SUBSCRIBE_ALL=true
BACKEND_TELEPHONY_EVENTS_URL=http://127.0.0.1:8000/api/telephony/events
# Optional: lets the ARI bridge react to admin approve/reject WebSocket events.
# Use an admin JWT for local testing; keep it out of git.
BACKEND_WS_URL=ws://127.0.0.1:8000/ws
# Same secret as backend WS_BROADCAST_BRIDGE_TOKEN so the bridge can subscribe to /ws without an admin JWT.
BACKEND_WS_TOKEN=
# Backend only: WS_BROADCAST_BRIDGE_TOKEN=<same as BACKEND_WS_TOKEN>

# Perceived-RTP warmup: short sleep before first audio (+ optional Asterisk silence media).
ASTERISK_PROMPT_PREROLL_MS=300
# Prepends this many ms of PCM silence onto the first synthesized TTS WAV after answer (stops clipped “Hello”).
# Raise toward ~700 only if needed; clarity beats shaving milliseconds.
ASTERISK_PROMPT_INITIAL_SILENCE_MS=500
# Extra pause after Asterisk finishes a hangup-terminated prompt before ARI hangs up ("Goodbye" fully audible).
ASTERISK_PROMPT_TAIL_PADDING_MS=300

# Static Asterisk prompt sound names. Put recordings under Asterisk sounds/ivr/.
# Dynamic name/university TTS is not implemented; use generic approved recordings for now.
ASTERISK_PROMPT_CONSENT=ivr/consent
ASTERISK_PROMPT_VERIFICATION_CODE=ivr/verification-code
ASTERISK_PROMPT_PENDING_ADMIN=ivr/pending-admin
ASTERISK_PROMPT_APPROVED=ivr/approved
ASTERISK_PROMPT_REJECTED=ivr/rejected
ASTERISK_PROMPT_FAILED=ivr/failed
ASTERISK_PROMPT_DECLINED=ivr/declined
# Static sound after admin clicks Done — code sent ("please enter the code").
ASTERISK_PROMPT_CODE_SENT=ivr/code-sent

# ADMIN_CODE_SENT_CONFIRMED audio: default tts synthesizes speech script text (typically ~1–2s overhead).
# Set to asterisk to play ASTERISK_PROMPT_CODE_SENT immediately from disk (no synth).
ASTERISK_ADMIN_CODE_SENT_AUDIO_MODE=tts

# Backend webhook (from inside Asterisk container reach host API)
# TELEPHONY_WEBHOOK_BASE=http://host.docker.internal:8000/api/telephony/events

# Generic SIP provider / Narayana trunk example.
# Keep TELEPHONY_PROVIDER=sip_up in the backend when routing through SIP UP.
# Do not commit real provider credentials.
# Observed Narayana device values:
# - SIP Login: 372810444412235
# - SIP Server: rdx.narayana.im
# - Caller ID: 393888736444 (SIP UP dashboard)
# - Caller ID: 1888110088 (Narayana dashboard)
# - IP Auth: 196.179.131.193 (whitelist this public IP in Narayana dashboard)
NARAYANA_ENABLE_REGISTRATION=0
# SIP password must be copied/generated from Narayana SIP device settings.
# PIN Code is not assumed to be the SIP password unless Narayana confirms it.
# If registration is rejected, confirm whether Narayana requires WebRTC/DTLS-SRTP or IP authentication.
# If IP Auth is required, replace the placeholder/private IP with the public Asterisk server IP in Narayana dashboard.
NARAYANA_SIP_DOMAIN=rdx.narayana.im
NARAYANA_SIP_USERNAME=372810444412235
NARAYANA_SIP_PASSWORD=
NARAYANA_SIP_PORT=5061
NARAYANA_SIP_TRANSPORT=tls
NARAYANA_DTMF_MODE=rfc4733
SIPUP_DTMF_MODE=rfc4733
NARAYANA_OUTBOUND_CALLER_ID=372810444413304

# Outbound dial-string normalization for the Narayana trunk.
# Most SIP trunk providers (and Narayana for Tunisia +216 traffic) reject the
# leading "+" in the user part of the SIP URI, so the safe default is digits
# only. If the trunk does not ring, try the alternatives below in order:
#   e164_plus         -> +21652603967
#   e164_no_plus      -> 21652603967     (default; recommended for Narayana)
#   international_00  -> 0021652603967
#   national          -> 52603967         (strips NARAYANA_DEFAULT_COUNTRY_CODE)
#   raw               -> pass-through ("+" and digits only, no other change)
# Use the manual originate commands in docs/runbooks/narayana-real-call-integration.md
# to discover which format Narayana accepts for your account, then set it here.
NARAYANA_DIAL_FORMAT=e164_no_plus
NARAYANA_DEFAULT_COUNTRY_CODE=216
NARAYANA_DIAL_PREFIX=

# Narayana PJSIP endpoint name in Asterisk (modal "Narayana" / outbound_trunk=default).
NARAYANA_PJSIP_ENDPOINT=narayana-trunk

SIPUP_SIP_DOMAIN=sip.sipup.org
# Backend merges SIPUP_* into FastAPI after backend/.env (local APP_ENV).
# Docker: pjsip-render service regenerates config/pjsip.conf on every ``docker compose up``.
SIPUP_SIP_DOMAIN=sip.sipup.org
# SIPUP_SIP_HOST=178.162.235.72
SIPUP_SIP_PORT=5060
SIPUP_SIP_USERNAME=
SIPUP_SIP_PASSWORD=
SIPUP_PJSIP_ENDPOINT=sip-up-trunk
SIPUP_OUTBOUND_CALLER_ID=
# Tunisia on SIP UP often requires national digits only (56340093), not 21656340093 (403 Forbidden).
SIPUP_DIAL_FORMAT=national
SIPUP_DIAL_PREFIX=
SIPUP_DEFAULT_COUNTRY_CODE=216
# First-time setup: bash scripts/setup-sipup-local.sh
# Manual render: python3 scripts/render_pjsip_from_env.py
