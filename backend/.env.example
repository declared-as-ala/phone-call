# Copy this file to `.env` in the same folder (backend/.gitignore keeps `.env` untracked).
# The backend auto-loads `backend/.env` on startup (`app.config`).

APP_ENV=development
# Production/staging must set DATABASE_URL and each secret below explicitly.
# DATABASE_URL=sqlite:///./ivr_verification.db
# JWT_SECRET_KEY=
# DTMF_BUFFER_SECRET=
# Browser origins allowed to make credentialed API requests (comma-separated).
# Development defaults to localhost/127.0.0.1 ports 5173-5189 when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Admin session and login protection.
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# AUTH_COOKIE_SECURE=0
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Encrypts the admin-edited SIP password stored in backend/.local/sip_up_account.json.
# Required in staging/production. Generate with: openssl rand -hex 32
# SIP_UP_SETTINGS_SECRET=
# Leave mock unless your whole stack uses SIP UP (sip_up mode) (required vars are stricter).
TELEPHONY_PROVIDER=mock

# SIP UP media REST (ARI) — same host your browser would use to reach the lab container.
ASTERISK_HOST=127.0.0.1
ASTERISK_PORT=8088
ASTERISK_USERNAME=ari-dev-user
# Must match the password for `[ari-dev-user]` in infra/sipup/config/ari.conf
ASTERISK_PASSWORD=
ASTERISK_CONTEXT=ivr-outbound
ASTERISK_ENDPOINT=sip-up-trunk

# SIP UP (outbound_trunk=sip_up) — SipUpTelephonyProvider; does not read SIP UP media vars.
# SIP UP Telecom dashboard: „Paramètres de connexion SIP“ → sip.sipup.org (often also shown as IP + port 5060).
# Registrar — SIPUP_SIP_DOMAIN and/or SIPUP_SIP_HOST (either is enough).
# Local development only: if both unset, defaults to sip.sipup.org unless SIPUP_FALLBACK_REGISTRAR= disables it.
SIPUP_SIP_DOMAIN=sip.sipup.org
# SIPUP_SIP_HOST=178.162.235.72
# Override builtin registrar or disable it in dev: SIPUP_FALLBACK_REGISTRAR=sip.other.example / SIPUP_FALLBACK_REGISTRAR=
SIPUP_SIP_PORT=5060
# Appareils/Devices tab: „Nom d'utilisateur“ / password (NOT necessarily the „Paramètres“ web-login username).
SIPUP_SIP_USERNAME=
SIPUP_SIP_PASSWORD=
# PJSIP trunk id inside your stack (often sip-up-trunk to match infra/sipup; used in dial/logging).
SIPUP_PJSIP_ENDPOINT=sip-up-trunk
# Appareils tab: Caller ID „Numéro d'identification de l'appelant“ (e.g. 393888736444).
SIPUP_OUTBOUND_CALLER_ID=28897028
# Optional: POST JSON originate handoff — see SipUpTelephonyProvider in backend.
# SIPUP_ORIGINATE_POST_URL=
# SIPUP_ORIGINATE_POST_TOKEN=

# SIPUP_DEFAULT_COUNTRY_CODE=39
# SIPUP_DIAL_FORMAT=national (optional; default national per dial_plan)

# LuvVoice premium TTS (default speech_engine=luvvoice on new calls)
# Dashboard → API Tokens (Plus plan or higher). Requires ffmpeg on the host for MP3→WAV.
LUVVOICE_API_TOKEN=
LUVVOICE_DEFAULT_VOICE_ID=voice-001

# Always use LuvVoice for your speech-script text (no generic static clips when cache is cold).
IVR_TTS_COLD_STATIC_FALLBACK=0
# Ms to wait on answer for ring-time prefetch before blocking LuvVoice synth (default 1500).
IVR_TTS_CACHE_WAIT_MS=10000

# Optional: disable auto-merge of infra/sipup/.env (normally on in APP_ENV≠production/staging.)
# BACKEND_MERGE_INFRA_SIPUP_DOTENV=0

# Shared secret for POST /api/telephony/events (HMAC-SHA256 request signing).
# Required in staging/production; unset here means the local dev webhook stays
# unsigned (matches the current local Asterisk lab dry-run flow). Must match
# whatever the ARI bridge process (scripts/run_sip_up_ari_bridge.py) is given —
# generate with: openssl rand -hex 32
# TELEPHONY_WEBHOOK_SECRET=
# TELEPHONY_WEBHOOK_TOLERANCE_SECONDS=300
