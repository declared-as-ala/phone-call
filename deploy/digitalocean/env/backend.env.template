APP_ENV=production
TELEPHONY_PROVIDER=sip_up
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_DOMAIN
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=1
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
SIP_UP_SETTINGS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

DATABASE_URL=sqlite:////opt/ivr-project/backend/ivr_verification.db

ASTERISK_HOST=127.0.0.1
ASTERISK_PORT=8088
ASTERISK_USERNAME=ari-dev-user
ASTERISK_PASSWORD=CHANGE_ME_MATCH_ARI_CONF
ASTERISK_CONTEXT=ivr-outbound
ASTERISK_ENDPOINT=sip-up-trunk

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME
DTMF_BUFFER_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
WS_BROADCAST_BRIDGE_TOKEN=CHANGE_ME_SAME_AS_BACKEND_WS_TOKEN_IN_ASTERISK_ENV

# Required in production — POST /api/telephony/events rejects unsigned requests once set.
# Generate: openssl rand -hex 32. Must match TELEPHONY_WEBHOOK_SECRET given to the ARI bridge
# service (ivr-ari-bridge.service / infra/sipup env), not just this backend service.
TELEPHONY_WEBHOOK_SECRET=CHANGE_ME

SIPUP_SIP_DOMAIN=sip.sipup.org
SIPUP_SIP_USERNAME=
SIPUP_SIP_PASSWORD=
SIPUP_OUTBOUND_CALLER_ID=
SIPUP_PJSIP_ENDPOINT=sip-up-trunk

LUVVOICE_API_TOKEN=
VITE_ENABLE_MOBILE_SIMULATOR=false

BACKEND_MERGE_INFRA_SIPUP_DOTENV=0
