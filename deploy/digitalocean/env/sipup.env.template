APP_ENV=production
TELEPHONY_PROVIDER=sip_up

ASTERISK_SIP_BIND=5060
ASTERISK_HTTP_BIND=8088
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10100

ASTERISK_HOST=127.0.0.1
ASTERISK_PORT=8088
ASTERISK_USERNAME=ari-dev-user
ASTERISK_PASSWORD=CHANGE_ME_MATCH_BACKEND

BACKEND_TELEPHONY_EVENTS_URL=http://127.0.0.1:8000/api/telephony/events
BACKEND_WS_URL=ws://127.0.0.1:8000/ws
BACKEND_WS_TOKEN=CHANGE_ME_SAME_AS_WS_BROADCAST_BRIDGE_TOKEN
# Must be identical to TELEPHONY_WEBHOOK_SECRET in backend.env.template — signs every
# POST /api/telephony/events request this bridge sends.
TELEPHONY_WEBHOOK_SECRET=CHANGE_ME_SAME_AS_BACKEND_TELEPHONY_WEBHOOK_SECRET

SIPUP_SIP_DOMAIN=sip.sipup.org
SIPUP_SIP_USERNAME=
SIPUP_SIP_PASSWORD=
SIPUP_PJSIP_ENDPOINT=sip-up-trunk
